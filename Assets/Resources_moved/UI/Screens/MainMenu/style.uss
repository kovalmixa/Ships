}

Button {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
    font-size: 100%;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&guid=e3265ab4bf004d28a9537516768c1c75&type=3#LiberationSans");
    border-bottom-width: 9px;
    border-left-color: rgb(116, 106, 106);
    border-right-color: rgb(116, 106, 106);
    border-top-color: rgb(116, 106, 106);
    border-bottom-color: rgb(43, 37, 37);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 0;
}

