<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources_moved/UI/style.uss?fileID=7433441132597879392&amp;guid=d99d236084a63764eb1a923ba22c455e&amp;type=3#style" />
    <ui:VisualElement name="Image" style="flex-grow: 1; width: auto; height: auto; background-image: url(&quot;project://database/Assets/Graphics/UI/Screens/MainMenuImages/images.jpg?fileID=2800000&amp;guid=d6f636c6e286da4478acb6a656f80618&amp;type=3#images&quot;); background-size: cover; background-position: center; justify-content: space-between; top: auto; align-items: auto; align-self: auto; align-content: auto; flex-direction: column; left: auto; bottom: auto; border-left-color: rgba(0, 0, 0, 0.82); border-right-color: rgba(0, 0, 0, 0.82); border-top-color: rgba(0, 0, 0, 0.82); border-bottom-color: rgba(0, 0, 0, 0.82); border-bottom-width: 20px; border-top-width: 20px;">
        <ui:VisualElement name="MenuPanelBackground" style="flex-grow: 1; width: 25%; height: auto; background-image: none; background-size: 100% 100%; -unity-background-image-tint-color: rgb(158, 195, 242); justify-content: center; align-items: center; background-color: rgba(2, 0, 22, 0.67); align-self: flex-start; align-content: flex-start; border-right-width: 6px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);">
            <ui:VisualElement name="Logo" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Resources_moved/UI/MainTabs/MainMenu/Logo.png?fileID=2800000&amp;guid=51836ee17ff5f714aa5aff1e4afbe111&amp;type=3#Logo&quot;); width: 80%; height: auto; top: auto; background-size: 100% 15%; right: auto; left: auto; bottom: auto;" />
            <ui:VisualElement name="Buttons" style="width: 70%; flex-direction: column; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0); position: relative; top: auto; left: auto; height: auto; align-self: center; bottom: 7%; right: auto;">
                <ui:Button text="Continue" name="ContinueButton" class="menu-button" style="width: 100%; height: auto; margin-bottom: 12px; background-image: none;" />
                <ui:Button text="Save/Load" name="SaveLoadButton" class="menu-button" style="width: 100%; height: auto; margin-bottom: 12px; background-image: none;" />
                <ui:Button text="New game" selectable="false" focusable="false" name="NewGameButton" class="menu-button" style="width: 100%; height: auto; margin-bottom: 12px; background-image: none;" />
                <ui:Button text="Options" name="Options" class="menu-button" style="width: 100%; height: auto; margin-bottom: 12px; background-image: none;" />
                <ui:Button text="Quit" name="Quit" class="menu-button" style="width: 100%; height: auto; background-image: none;" />
            </ui:VisualElement>
        </ui:VisualElement>
