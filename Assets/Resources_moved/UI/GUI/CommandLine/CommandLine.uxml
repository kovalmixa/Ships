<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 50%; height: 70%; margin-bottom: 20%; justify-content: flex-end; align-items: stretch; flex-direction: column; background-color: rgba(0, 0, 0, 0.5);">
        <ui:ScrollView name="MessageContainer" />
        <ui:TextField placeholder-text="Input command" name="CommandLineInput" />
    </ui:VisualElement>
</ui:UXML>
