.inventory-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap; /* Ёлементы будут переноситьс€ на новую строку */
    justify-content: flex-start;
    gap: 2px; /* –ассто€ние между €чейками */
}
.inventory-slot {
    width: 64px;
    height: 64px;
    background-color: rgba(0, 0, 0, 0.4);
    border-color: rgba(0, 0, 0, 0.7);
    border-width: 2px;
}

.panel {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    background-color: rgba(17, 1, 30, 0.3);
    border-left-color: rgb(32, 22, 41);
    border-right-color: rgb(32, 22, 41);
    border-top-color: rgb(32, 22, 41);
    border-bottom-color: rgb(32, 22, 41);
}