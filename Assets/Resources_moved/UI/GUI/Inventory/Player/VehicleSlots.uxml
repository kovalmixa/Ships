<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="InventorySlot" src="project://database/Assets/Resources_moved/UI/GUI/Inventory/InventorySlot.uxml?fileID=9197481963319205126&amp;guid=2663f4dacfb3a974d8eb28255079bcf2&amp;type=3#InventorySlot"/>
    <Style src="project://database/Assets/Resources_moved/UI/GUI/Inventory/Style.uss?fileID=7433441132597879392&amp;guid=21b8d740ee89dd742a6eeb320012d30a&amp;type=3#Style"/>
    <ui:VisualElement style="flex-grow: 1; margin-top: 5%; margin-bottom: 5%;">
        <ui:VisualElement name="HullSlots" style="flex-grow: 1; height: 64%; flex-direction: row;">
            <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot" style="height: 95%; width: 200px;"/>
            <ui:VisualElement name="Equipments" style="flex-grow: 1;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BottomPanel" class="panel" style="flex-grow: 1; flex-direction: row; margin-bottom: 0%;">
            <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot" style="width: 128px; height: 128px;"/>
            <ui:VisualElement name="Accessories" class="inventory-grid" style="flex-grow: 1; align-self: auto; align-items: center; height: 100%; flex-wrap: wrap; width: initial; justify-content: space-evenly; background-color: rgba(0, 0, 0, 0);">
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: center; justify-content: space-around;">
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
                <ui:Instance template="InventorySlot" name="TemplateContainer" class="inventory-slot"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
