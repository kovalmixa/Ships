<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources_moved/UI/GUI/GameInterface/Style.uss?fileID=7433441132597879392&amp;guid=d182ea587ed7f4e43b9cb4dbd0bc46a5&amp;type=3#Style" />
    <ui:VisualElement style="flex-grow: 1; align-self: auto; align-content: auto; justify-content: flex-start; align-items: stretch;">
        <ui:VisualElement name="Top" style="flex-grow: 1; height: auto; min-height: 50%;">
            <ui:VisualElement name="Top" style="flex-grow: 1; flex-direction: row; width: auto; height: auto; min-height: 125%;">
                <ui:VisualElement name="Minimap" enabled="true" class="minimap-frame" style="flex-grow: 1; background-color: rgb(0, 0, 0); width: 100%; height: auto;" />
                <ui:VisualElement name="Buttons" class="button-panel" style="flex-grow: 1; flex-direction: row; height: 3%; align-items: center; justify-content: space-between;">
                    <ui:Button text="Options" name="OptionsButton" />
                    <ui:Button text="Quests" name="QuestsButton" />
                    <ui:Button text="Inventory" name="InventoryButton" />
                    <ui:Button text="SkillTree" name="SkillTreeButton" />
                </ui:VisualElement>
                <ui:VisualElement name="Dialogue" style="flex-grow: 1; width: 40%;" />
            </ui:VisualElement>
            <ui:VisualElement name="Bottom" style="flex-grow: 1;">
                <ui:VisualElement name="QuestTask" style="flex-grow: 1; background-color: rgb(0, 0, 0); width: 80px; height: 454px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Bottom" style="flex-grow: 1; margin-top: 0%; align-content: auto; align-self: auto; justify-content: flex-end;">
            <ui:VisualElement name="Abilities" style="flex-grow: initial; align-items: center; height: 29%;">
                <ui:VisualElement name="AbilitiesPanel" class="abilities-panel" style="flex-grow: 1; flex-direction: row; align-self: center; align-items: flex-end; height: auto; background-color: rgba(0, 0, 0, 0.7); width: 60%;">
                    <ui:VisualElement name="KeyboardAbilities" class="abilities-panel" style="flex-grow: initial; align-items: auto; justify-content: flex-start; width: auto; margin-right: 0%; margin-left: 0%;">
                        <ui:Button text="Button" name="AbButton1" />
                        <ui:Button text="Button" name="AbButton2" />
                        <ui:Button text="Button" name="AbButton3" />
                        <ui:Button text="Button" name="AbButton4" />
                        <ui:Button text="Button" name="AbButton5" />
                        <ui:Button text="Button" name="AbButton6" />
                        <ui:Button text="Button" name="AbButton7" />
                        <ui:Button text="Button" name="AbButton8" />
                        <ui:Button text="Button" name="AbButton9" />
                        <ui:Button text="Button" name="AbButton0" />
                    </ui:VisualElement>
                    <ui:VisualElement name="MouseAbiblities" style="flex-grow: initial; flex-direction: row; align-items: auto; margin-left: 7%;">
                        <ui:Button text="Button" name="AbButtonLb" />
                        <ui:Button text="Button" name="AbButtonRb" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:ProgressBar value="22" title="my-progress" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
